# =============================================================================
#  .env - WHERE THE SETTINGS COME FROM
# =============================================================================
#
#  Copy this file to ".env" and edit it:
#
#      PowerShell:  Copy-Item .env.example .env
#
#  config.py reads ".env" when it starts, so every script in this project
#  picks these up automatically. Nothing else reads it.
#
#  Two rules worth knowing:
#
#    1. A REAL environment variable always wins over this file.
#       So `$env:SQL_DATABASE = "riderdrop_ali"` beats whatever is below,
#       which is handy for trying something once without editing anything.
#
#    2. ".env" is in .gitignore. ".env.example" is not.
#       The example shows the NAMES of the settings, the real one holds YOUR
#       values, and the real one never reaches GitHub. Never put a password
#       in .env.example.
#
#  Lines starting with # are ignored. Delete the # to turn a setting on.
# =============================================================================


# --- Where is the database? --------------------------------------------------

# "localhost" means SQL Server on this computer. Named instance? Use the
# full name, e.g. localhost\SQLEXPRESS
#SQL_SERVER=localhost

# IF YOUR CLASS SHARES ONE SQL SERVER, CHANGE THIS.
# Otherwise thirty students write into one database and overwrite each other.
#SQL_DATABASE=riderdrop_yourname

# Install "ODBC Driver 18 for SQL Server" if this fails. pyodbc is the Python
# side; the driver is a separate Windows install.
#SQL_DRIVER=ODBC Driver 18 for SQL Server


# --- How do we log in? -------------------------------------------------------

# LEAVE THESE COMMENTED OUT IF YOU CAN.
#
# Empty user = Trusted_Connection=yes = your Windows login. Nothing to type,
# nothing to leak, nothing to rotate. It is the better option whenever it
# works, and on a local SQL Server it usually does.
#
# Fill them in only if your SQL Server refuses your Windows login - Docker,
# a Linux host, or a shared class server handing out logins.

#SQL_USER=sa
#SQL_PASSWORD=put-your-password-here


# --- Where are the CSV files? ------------------------------------------------

# Only needed if the data is NOT in the "data" folder beside this file.
# Normally you just run:  python make_data.py
#DATA_DIR=C:\path\to\the\files
